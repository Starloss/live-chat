generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdChannels     Channel[]            @relation("channel_creator")
  memberships         ChannelMember[]
  messages            Message[]
  presences           UserPresence[]
  typingStates        TypingState[]
  channelJoinRequests ChannelJoinRequest[]
}

model Channel {
  id          String            @id @default(cuid())
  name        String            @unique
  createdById String
  visibility  ChannelVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now())

  createdBy    User                 @relation("channel_creator", fields: [createdById], references: [id])
  members      ChannelMember[]
  messages     Message[]
  typing       TypingState[]
  joinRequests ChannelJoinRequest[]
}

model ChannelJoinRequest {
  id        String               @id @default(cuid())
  channelId String
  userId    String
  status    ChannelRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId, status])
  @@index([userId, status])
}

model ChannelMember {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  role      ChannelRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
}

model UserPresence {
  id         String         @id @default(cuid())
  userId     String
  status     PresenceStatus @default(OFFLINE)
  lastSeenAt DateTime?
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model TypingState {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  isTyping  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId, isTyping])
}

enum ChannelRole {
  OWNER
  MEMBER
}

enum PresenceStatus {
  ONLINE
  OFFLINE
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelRequestStatus {
  PENDING
  APPROVED
  DENIED
}

{
  "name": "live-chat",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @live-chat/web dev",
    "dev:api": "pnpm --filter @live-chat/api dev",
    "db:up": "docker compose up -d db",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:api": "pnpm --filter @live-chat/api test",
    "test:e2e:web": "pnpm --filter @live-chat/web test:e2e"
  }
}
